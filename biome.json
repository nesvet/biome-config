{
	"$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
	"files": {
		"ignoreUnknown": true
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 320,
		"lineEnding": "lf"
	},
	"javascript": {
		"globals": ["Bun"],
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "always",
			"trailingCommas": "none",
			"arrowParentheses": "asNeeded",
			"bracketSpacing": true
		}
	},
	"json": {
		"formatter": {
			"enabled": true,
			"trailingCommas": "none"
		},
		"linter": {
			"enabled": true
		}
	},
	"markdown": {
		"formatter": {
			"enabled": true,
			"formatEmbeds": true,
			"proseWrap": "preserve"
		},
		"linter": {
			"enabled": true
		},
		"parser": {
			"frontmatter": true,
			"gfm": true
		},
		"analyzeEmbeds": false
	},
	"yaml": {
		"formatter": {
			"enabled": true,
			"quoteStyle": "double"
		},
		"linter": {
			"enabled": true
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": {
					"level": "on",
					"options": {
						"sortBareImports": true,
						"groups": [[":BUN:", ":NODE:"], ":PACKAGE:", ":ALIAS:", ":PATH:", ":STYLE:"]
					}
				}
			}
		}
	},
	"linter": {
		"enabled": true,
		"domains": {
			"types": "all"
		},
		"rules": {
			"preset": "recommended",
			"complexity": {
				"noForEach": "warn"
			},
			"nursery": {
				"noFloatingPromises": "error",
				"noImpliedEval": "error",
				"noInvalidPropertyInitValue": "error",
				"noMisusedPromises": "error",
				"useAwaitThenable": "error",
				"useConsistentHeadingLevel": "warn",
				"useFencedCodeLanguage": "warn",
				"useSingleTopLevelHeading": "warn"
			},
			"security": {
				"noGlobalEval": "error"
			},
			"correctness": {
				"noUnusedImports": "error",
				"noUnusedFunctionParameters": {
					"level": "error",
					"options": {
						"ignoreRestSiblings": true
					}
				},
				"noUnusedVariables": {
					"level": "error",
					"options": {
						"ignoreRestSiblings": true
					}
				}
			},
			"style": {
				"noCommonJs": "error",
				"noParameterAssign": "error",
				"useArrayLiterals": "warn",
				"useBlockStatements": "error",
				"useConst": "warn",
				"useConsistentTypeDefinitions": {
					"level": "error",
					"options": {
						"style": "type"
					}
				},
				"useExportType": "error",
				"useImportType": "error",
				"useNamingConvention": {
					"level": "error",
					"options": {
						"strictCase": false,
						"conventions": [
							{
								"selector": { "kind": "const", "scope": "global" },
								"match": "(?:[_$]*)?(.*)",
								"formats": ["camelCase", "CONSTANT_CASE", "PascalCase"]
							},
							{
								"selector": { "kind": "const" },
								"match": "(?:[_$]*)?(.*)",
								"formats": ["camelCase", "PascalCase"]
							},
							{
								"selector": { "kind": "variable" },
								"match": "(?:[_$]*)?(.*)",
								"formats": ["camelCase"]
							},
							{
								"selector": { "kind": "objectLiteralProperty" },
								"match": "(?:[_$]*)?(.*)",
								"formats": ["camelCase", "CONSTANT_CASE"]
							},
							{
								"selector": { "kind": "typeProperty" },
								"match": "(?:[_$]*)?(.*)",
								"formats": ["camelCase", "CONSTANT_CASE"]
							},
							{
								"selector": { "kind": "function" },
								"match": "(?:[_$]*)?(.*)",
								"formats": ["camelCase", "PascalCase"]
							},
							{
								"selector": { "kind": "class" },
								"formats": ["PascalCase"]
							},
							{
								"selector": { "kind": "interface" },
								"formats": ["PascalCase"]
							},
							{
								"selector": { "kind": "typeAlias" },
								"formats": ["PascalCase"]
							},
							{
								"selector": { "kind": "enum" },
								"formats": ["PascalCase"]
							},
							{
								"selector": { "kind": "enumMember" },
								"formats": ["PascalCase"]
							}
						]
					}
				},
				"useErrorCause": "warn",
				"useNodejsImportProtocol": "off",
				"useThrowNewError": "error",
				"useThrowOnlyError": "error",
				"noDefaultExport": "warn"
			},
			"suspicious": {
				"noLoopFunc": "warn",
				"noConsole": {
					"level": "warn",
					"options": {
						"allow": ["info", "warn", "error", "group", "groupEnd"]
					}
				},
				"noEvolvingTypes": "warn",
				"noUnassignedVariables": "error",
				"noDoubleEquals": {
					"level": "error",
					"options": {
						"ignoreNull": true
					}
				},
				"noUnusedExpressions": "error",
				"noVar": "error",
				"noSelfCompare": "error",
				"noTemplateCurlyInString": "error",
				"useAwait": "error"
			}
		}
	},
	"overrides": [
		{
			"includes": ["**/*.{jsx,tsx}"],
			"linter": {
				"rules": {
					"correctness": {
						"useExhaustiveDependencies": "warn",
						"noUnknownProperty": "error",
						"noChildrenProp": "error",
						"useJsxKeyInIterable": "error"
					},
					"a11y": {
						"useKeyWithClickEvents": "warn",
						"useValidAnchor": "warn"
					},
					"style": {
						"useSelfClosingElements": "warn"
					}
				}
			}
		},
		{
			"includes": ["**/*.{jsonc,json5}"],
			"json": {
				"formatter": {
					"enabled": true
				},
				"linter": {
					"enabled": true
				}
			}
		},
		{
			"includes": ["**/*.config.{ts,js,mjs,cjs,mts,cts}", "**/*.d.ts"],
			"linter": {
				"rules": {
					"style": {
						"noDefaultExport": "off"
					}
				}
			}
		}
	]
}
